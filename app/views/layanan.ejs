<%- include('partials/header', { title: 'Layanan | Desa Wonowoso' , page: 'layanan' }) %>

    <main>
        <!-- ==================== LAYANAN ==================== -->
        <!-- ==================== LAYANAN ==================== -->
        <!-- ==================== LAYANAN ==================== -->
        <section id="layanan" class="page active">
            <div class="page-header">
                <div class="container">
                    <h1>Layanan Surat</h1>
                    <nav class="breadcrumb">
                        <a href="/">Beranda</a>
                        <span>/</span>
                        <span>Layanan</span>
                    </nav>
                </div>
            </div>

            <div class="section">
                <div class="container">
                    <div class="layanan-grid">
                        <% if (typeof layanans !=='undefined' && layanans.length> 0) { %>
                            <% layanans.forEach((item, index)=> { %>
                                <div class="card layanan-card h-100 border-0 shadow-lg rounded-lg overflow-hidden position-relative"
                                    onclick="window.location.href='/layanan/<%= item._id %>'" style="cursor: pointer;">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="icon-wrapper bg-primary-light text-primary mb-4">
                                            <i class="<%= item.icon || 'fas fa-file-alt' %>"></i>
                                        </div>
                                        <h3 class="h5 fw-bold mb-3">
                                            <%= item.title %>
                                        </h3>
                                        <p class="text-muted small mb-4 flex-grow-1">
                                            <%= item.description.substring(0, 100) %>...
                                        </p>

                                        <div
                                            class="d-flex align-items-center justify-content-between mt-auto pt-3 border-top border-light">
                                            <span class="text-xs text-primary fw-bold text-uppercase">
                                                Lihat Detail <i class="fas fa-arrow-right ms-1"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <!-- Fallback Static Content -->
                                        <div class="col-12 text-center py-5">
                                            <div class="empty-state">
                                                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                                <p class="text-muted">Belum ada layanan yang tersedia saat ini.</p>
                                            </div>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </div>
            </div>
            </div>

    </main>

    <%- include('partials/footer') %>

        <!-- Modal Detail Layanan -->
        <div class="modal" id="modalDetail">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="detailTitle">Detail Layanan</h3>
                    <button class="modal-close" onclick="closeModal('modalDetail')">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="detail-icon" style="text-align: center; margin-bottom: 20px;">
                        <i id="detailIcon" class="fas fa-file-alt" style="font-size: 48px; color: var(--primary);"></i>
                    </div>
                    <p id="detailDescription" style="margin-bottom: 20px; text-align: center; color: var(--gray-600);">
                    </p>

                    <div class="layanan-requirements">
                        <h4><i class="fas fa-list-check"></i> Persyaratan Dokumen:</h4>
                        <ul id="detailRequirements">
                            <!-- List requirements will be injected here -->
                        </ul>
                    </div>

                    <div id="templateSection" style="margin-top: 20px; display: none;">
                        <h4><i class="fas fa-file-download"></i> Dokumen Template:</h4>
                        <a id="downloadTemplate" href="#" class="btn btn-outline btn-sm" download>
                            <i class="fas fa-download"></i> Download Format Surat
                        </a>
                    </div>

                    <div style="margin-top: 30px;">
                        <button id="btnAjukan" class="btn btn-primary btn-block">
                            <i class="fas fa-paper-plane"></i> Ajukan Permohonan Sekarang
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Form Pengajuan -->
        <div class="modal" id="modalSurat">
            <div class="modal-content">
                <div class="modal-header">
                    <h3><i class="fas fa-file-signature"></i> Form Pengajuan Surat</h3>
                    <button class="modal-close" onclick="closeModal('modalSurat')">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="formSurat" action="/layanan/ajukan" method="POST" enctype="multipart/form-data">
                        <input type="hidden" id="layananId" name="layananId">
                        <div class="form-group">
                            <label>Jenis Layanan</label>
                            <input type="text" id="namaLayanan" class="form-control" readonly
                                style="background: #f5f5f5;">
                        </div>

                        <div class="form-group">
                            <label>Nama Lengkap <span class="text-danger">*</span></label>
                            <input type="text" name="nama" placeholder="Sesuai KTP" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Jenis Kelamin <span class="text-danger">*</span></label>
                                <select name="jenisKelamin" class="form-control" required>
                                    <option value="">Pilih Jenis Kelamin</option>
                                    <option value="Laki-laki">Laki-laki</option>
                                    <option value="Perempuan">Perempuan</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Tempat Lahir <span class="text-danger">*</span></label>
                                <input type="text" name="tempatLahir" placeholder="Tempat lahir" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Tanggal Lahir <span class="text-danger">*</span></label>
                                <input type="date" name="tanggalLahir" required>
                            </div>
                            <div class="form-group">
                                <label>Kewarganegaraan <span class="text-danger">*</span></label>
                                <input type="text" name="kewarganegaraan" placeholder="Kewarganegaraan" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Agama <span class="text-danger">*</span></label>
                                <input type="text" name="agama" placeholder="Agama" required>
                            </div>
                            <div class="form-group">
                                <label>Pekerjaan <span class="text-danger">*</span></label>
                                <input type="text" name="pekerjaan" placeholder="Pekerjaan" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>RT <span class="text-danger">*</span></label>
                                <input type="text" name="rt" placeholder="RT" required>
                            </div>
                            <div class="form-group">
                                <label>RW <span class="text-danger">*</span></label>
                                <input type="text" name="rw" placeholder="RW" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Email <span class="text-danger">*</span></label>
                                <input type="email" name="email" placeholder="contoh@email.com" required>
                            </div>
                            <div class="form-group">
                                <label>No. WhatsApp <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" placeholder="08xxxxxxxxxx" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Alamat Lengkap <span class="text-danger">*</span></label>
                            <textarea name="address" rows="2" placeholder="Jalan, RT/RW, Dusun" required></textarea>
                        </div>

                        <div class="form-group">
                            <label>Alamat Lengkap <span class="text-danger">*</span></label>
                            <textarea name="address" rows="2" placeholder="Jalan, RT/RW, Dusun" required></textarea>
                        </div>

                        <div class="form-group">
                            <label>File KTP</label>
                            <input type="file" name="ktpFile" accept=".pdf,.jpg,.jpeg,.png" class="form-control">
                            <div class="form-text">Unggah file KTP jika tersedia. Jika tidak, biarkan kosong.</div>
                        </div>

                        <div class="form-group">
                            <label>File KK</label>
                            <input type="file" name="kkFile" accept=".pdf,.jpg,.jpeg,.png" class="form-control">
                            <div class="form-text">Unggah file KK jika tersedia. Jika tidak, biarkan kosong.</div>
                        </div>

                        <div class="form-group">
                            <label>Keperluan / Keterangan Tambahan <span class="text-danger">*</span></label>
                            <textarea name="keperluan" rows="2" placeholder="Jelaskan keperluan pengajuan surat ini" required></textarea>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fas fa-paper-plane"></i> Kirim Pengajuan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            // Modal Functions
            function openModal(modalId) {
                const modal = document.getElementById(modalId);
                if (modal) {
                    // CSS .modal already has display:flex, but .active handles visibility/opacity
                    // We remove display manipulation effectively, or keep it to be safe 
                    // if .modal doesn't have display:none by default in CSS (it has display: flex).
                    // In style.css: .modal { display: flex; ... visibility: hidden }
                    // So we just need toggling class.
                    modal.classList.add('active');
                }
            }

            function closeModal(modalId) {
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.classList.remove('active');
                }
            }

            // Close modal when clicking outside
            window.onclick = function (event) {
                if (event.target.classList.contains('modal')) {
                    event.target.classList.remove('active');
                }
            }
            // Serialize data safely for JS usage
            let layanansData = [];
            try {
                layanansData = <%- JSON.stringify(layanans) %>;
                console.log('Layanan Data Loaded:', layanansData);
            } catch (e) {
                console.error('Failed to load layanan data:', e);
            }

            // Expose to window to ensure global access
            window.layanansData = layanansData;
            window.openDetail = openDetail;
            window.openModal = openModal;
            window.closeModal = closeModal;

            function openDetail(index) {
                const data = layanansData[index];

                // Populate Detail Modal
                document.getElementById('detailTitle').innerText = data.title;
                document.getElementById('detailDescription').innerText = data.description;
                document.getElementById('detailIcon').className = data.icon || 'fas fa-file-alt';

                // Requirements List
                const reqList = document.getElementById('detailRequirements');
                reqList.innerHTML = '';
                if (data.requirements && data.requirements.length > 0) {
                    data.requirements.forEach(req => {
                        const li = document.createElement('li');
                        li.innerHTML = `<i class="fas fa-check-circle text-primary"></i> ${req}`;
                        reqList.appendChild(li);
                    });
                } else {
                    reqList.innerHTML = '<li>Tidak ada persyaratan khusus.</li>';
                }

                // Template Download
                const templateSection = document.getElementById('templateSection');
                const downloadBtn = document.getElementById('downloadTemplate');
                if (data.templateDoc) {
                    templateSection.style.display = 'block';
                    downloadBtn.href = '/uploads/template_docs/' + data.templateDoc;
                } else {
                    templateSection.style.display = 'none';
                }

                // Setup "Ajukan" button in detail modal
                document.getElementById('btnAjukan').onclick = function () {
                    closeModal('modalDetail');
                    openSubmission(data);
                };

                openModal('modalDetail');
            }

            function openSubmission(data) {
                document.getElementById('layananId').value = data._id;
                document.getElementById('namaLayanan').value = data.title;
                openModal('modalSurat');
            }
        </script>