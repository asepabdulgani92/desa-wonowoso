<%- include('partials/header', { title: 'Galeri Foto | Desa Wonowoso' , page: 'galeri' }) %>

    <main>
        <!-- ==================== GALERI ==================== -->
        <section id="galeri" class="page active">
            <div class="page-header">
                <div class="container">
                    <h1>Galeri Foto</h1>
                    <nav class="breadcrumb">
                        <a href="/">Beranda</a>
                        <span>/</span>
                        <span>Galeri</span>
                    </nav>
                </div>
            </div>

            <div class="section">
                <div class="container">
                    <div class="galeri-filter">
                        <button class="filter-btn active" data-filter="all">Semua</button>
                        <button class="filter-btn" data-filter="kegiatan">Kegiatan</button>
                        <button class="filter-btn" data-filter="pembangunan">Pembangunan</button>
                        <button class="filter-btn" data-filter="wisata">Wisata</button>
                    </div>

                    <div class="galeri-grid">
                        <% if (typeof galeris !=='undefined' && galeris.length> 0) { %>
                            <% galeris.forEach(item=> { %>
                                <div class="galeri-item"
                                    data-category="<%= item.category ? item.category.toLowerCase() : 'kegiatan' %>">
                                    <img src="<%= item.image || 'https://images.unsplash.com/photo-1500076656116-558758c991c1?w=400' %>"
                                        alt="<%= item.title %>">
                                    <div class="galeri-overlay">
                                        <i class="fas fa-search-plus"></i>
                                        <span>
                                            <%= item.title %>
                                        </span>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <!-- Static Fallback -->
                                        <div class="galeri-item" data-category="kegiatan">
                                            <img src="https://images.unsplash.com/photo-1500076656116-558758c991c1?w=400"
                                                alt="Galeri">
                                            <div class="galeri-overlay">
                                                <i class="fas fa-search-plus"></i>
                                                <span>Gotong Royong</span>
                                            </div>
                                        </div>
                                        <!-- ... other static items -->
                                        <% } %>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>