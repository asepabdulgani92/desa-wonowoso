<div class="row">
    <div class="col-md-12">
        <div class="card card-outline card-info">
            <div class="card-header">
                <h3 class="card-title">
                    Edit Berita
                </h3>
            </div>
            <!-- /.card-header -->
            <div class="card-body">
                <form action="/admin/berita/<%= berita._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Judul Berita</label>
                        <input type="text" name="title" class="form-control" value="<%= berita.title %>" required>
                    </div>
                    <div class="form-group">
                        <label>Kategori</label>
                        <select name="category" class="form-control">
                            <option value="Kegiatan" <%=berita.category==='Kegiatan' ? 'selected' : '' %>>Kegiatan</option>
                            <option value="Sosial" <%=berita.category==='Sosial' ? 'selected' : '' %>>Sosial</option>
                            <option value="Pembangunan" <%=berita.category==='Pembangunan' ? 'selected' : '' %>>Pembangunan</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Gambar Saat Ini</label><br>
                        <% if(berita.image) { %>
                            <img src="<%= berita.image %>" height="100" class="rounded">
                            <% } else { %>
                                <p class="text-muted">Tidak ada gambar</p>
                                <% } %>
                    </div>
                    <div class="form-group">
                        <label>Ganti Gambar (Opsional)</label>
                        <div class="custom-file">
                            <input type="file" name="image" class="custom-file-input" id="customFile">
                            <label class="custom-file-label" for="customFile">Pilih file baru...</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Isi Berita</label>
                        <textarea name="content" class="form-control" rows="10"
                            required><%= berita.content %></textarea>
                    </div>

                    <div class="form-group">
                        <a href="/admin/berita" class="btn btn-secondary">Batal</a>
                        <button type="submit" class="btn btn-primary float-right">Simpan Perubahan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- /.col-->
</div>