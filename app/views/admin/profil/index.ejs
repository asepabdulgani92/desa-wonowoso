<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">Profil Desa</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                    <li class="breadcrumb-item active">Profil</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary card-outline card-tabs">
                    <div class="card-header p-0 pt-1 border-bottom-0">
                        <ul class="nav nav-tabs" id="custom-tabs-three-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="custom-tabs-three-sejarah-tab" data-toggle="pill"
                                    href="#custom-tabs-three-sejarah" role="tab"
                                    aria-controls="custom-tabs-three-sejarah" aria-selected="true">Sejarah</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="custom-tabs-three-visi-tab" data-toggle="pill"
                                    href="#custom-tabs-three-visi" role="tab" aria-controls="custom-tabs-three-visi"
                                    aria-selected="false">Visi & Misi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="custom-tabs-three-geo-tab" data-toggle="pill"
                                    href="#custom-tabs-three-geo" role="tab" aria-controls="custom-tabs-three-geo"
                                    aria-selected="false">Geografis</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="custom-tabs-three-demo-tab" data-toggle="pill"
                                    href="#custom-tabs-three-demo" role="tab" aria-controls="custom-tabs-three-demo"
                                    aria-selected="false">Demografis</a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <form action="/admin/profil" method="POST" enctype="multipart/form-data">
                            <div class="tab-content" id="custom-tabs-three-tabContent">

                                <!-- Sejarah Tab -->
                                <div class="tab-pane fade show active" id="custom-tabs-three-sejarah" role="tabpanel"
                                    aria-labelledby="custom-tabs-three-sejarah-tab">
                                    <div class="form-group">
                                        <label>Sejarah Desa</label>
                                        <textarea name="sejarah" class="form-control" rows="10"
                                            placeholder="Tuliskan sejarah desa..."><%= profil.sejarah %></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>Gambar Sejarah</label>
                                        <% if (profil.imageSejarah) { %>
                                            <div class="mb-2">
                                                <img src="<%= profil.imageSejarah %>" class="img-thumbnail"
                                                    style="max-height: 200px;">
                                                <div class="form-check mt-2">
                                                    <input type="checkbox" class="form-check-input"
                                                        name="deleteImageSejarah" id="deleteImageSejarah" value="true">
                                                    <label class="form-check-label text-danger"
                                                        for="deleteImageSejarah">Hapus Gambar</label>
                                                </div>
                                            </div>
                                            <% } %>
                                                <div class="custom-file">
                                                    <input type="file" class="custom-file-input" id="imageSejarah"
                                                        name="imageSejarah">
                                                    <label class="custom-file-label" for="imageSejarah">Pilih file
                                                        baru...</label>
                                                </div>
                                    </div>
                                </div>

                                <!-- Visi & Misi Tab -->
                                <div class="tab-pane fade" id="custom-tabs-three-visi" role="tabpanel"
                                    aria-labelledby="custom-tabs-three-visi-tab">
                                    <div class="form-group">
                                        <label>Visi</label>
                                        <textarea name="visi" class="form-control" rows="3"
                                            placeholder="Visi desa..."><%= profil.visi %></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>Gambar Visi</label>
                                        <% if (profil.imageVisi) { %>
                                            <div class="mb-2">
                                                <img src="<%= profil.imageVisi %>" class="img-thumbnail"
                                                    style="max-height: 200px;">
                                                <div class="form-check mt-2">
                                                    <input type="checkbox" class="form-check-input"
                                                        name="deleteImageVisi" id="deleteImageVisi" value="true">
                                                    <label class="form-check-label text-danger"
                                                        for="deleteImageVisi">Hapus Gambar</label>
                                                </div>
                                            </div>
                                            <% } %>
                                                <div class="custom-file">
                                                    <input type="file" class="custom-file-input" id="imageVisi"
                                                        name="imageVisi">
                                                    <label class="custom-file-label" for="imageVisi">Pilih file
                                                        baru...</label>
                                                </div>
                                    </div>
                                    <hr>
                                    <div class="form-group">
                                        <label>Misi (pisahkan dengan enter)</label>
                                        <textarea name="misi" class="form-control" rows="5"
                                            placeholder="Misi desa..."><%= profil.misi.join('\n') %></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>Gambar Misi</label>
                                        <% if (profil.imageMisi) { %>
                                            <div class="mb-2">
                                                <img src="<%= profil.imageMisi %>" class="img-thumbnail"
                                                    style="max-height: 200px;">
                                                <div class="form-check mt-2">
                                                    <input type="checkbox" class="form-check-input"
                                                        name="deleteImageMisi" id="deleteImageMisi" value="true">
                                                    <label class="form-check-label text-danger"
                                                        for="deleteImageMisi">Hapus Gambar</label>
                                                </div>
                                            </div>
                                            <% } %>
                                                <div class="custom-file">
                                                    <input type="file" class="custom-file-input" id="imageMisi"
                                                        name="imageMisi">
                                                    <label class="custom-file-label" for="imageMisi">Pilih file
                                                        baru...</label>
                                                </div>
                                    </div>
                                </div>

                                <!-- Geografis Tab -->
                                <div class="tab-pane fade" id="custom-tabs-three-geo" role="tabpanel"
                                    aria-labelledby="custom-tabs-three-geo-tab">
                                    <div class="form-group">
                                        <label>Data Geografis</label>
                                        <textarea name="geografis" class="form-control" rows="10"
                                            placeholder="Data geografis..."><%= profil.geografis %></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>Gambar Geografis (Peta/Denah)</label>
                                        <% if (profil.imageGeografis) { %>
                                            <div class="mb-2">
                                                <img src="<%= profil.imageGeografis %>" class="img-thumbnail"
                                                    style="max-height: 200px;">
                                                <div class="form-check mt-2">
                                                    <input type="checkbox" class="form-check-input"
                                                        name="deleteImageGeografis" id="deleteImageGeografis"
                                                        value="true">
                                                    <label class="form-check-label text-danger"
                                                        for="deleteImageGeografis">Hapus Gambar</label>
                                                </div>
                                            </div>
                                            <% } %>
                                                <div class="custom-file">
                                                    <input type="file" class="custom-file-input" id="imageGeografis"
                                                        name="imageGeografis">
                                                    <label class="custom-file-label" for="imageGeografis">Pilih file
                                                        baru...</label>
                                                </div>
                                    </div>
                                </div>

                                <!-- Demografis Tab -->
                                <div class="tab-pane fade" id="custom-tabs-three-demo" role="tabpanel"
                                    aria-labelledby="custom-tabs-three-demo-tab">
                                    <div class="form-group">
                                        <label>Data Demografis</label>
                                        <textarea name="demografis" class="form-control" rows="10"
                                            placeholder="Data kependudukan..."><%= profil.demografis %></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>Gambar Demografis (Grafik/Statistik)</label>
                                        <% if (profil.imageDemografis) { %>
                                            <div class="mb-2">
                                                <img src="<%= profil.imageDemografis %>" class="img-thumbnail"
                                                    style="max-height: 200px;">
                                                <div class="form-check mt-2">
                                                    <input type="checkbox" class="form-check-input"
                                                        name="deleteImageDemografis" id="deleteImageDemografis"
                                                        value="true">
                                                    <label class="form-check-label text-danger"
                                                        for="deleteImageDemografis">Hapus Gambar</label>
                                                </div>
                                            </div>
                                            <% } %>
                                                <div class="custom-file">
                                                    <input type="file" class="custom-file-input" id="imageDemografis"
                                                        name="imageDemografis">
                                                    <label class="custom-file-label" for="imageDemografis">Pilih file
                                                        baru...</label>
                                                </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Simpan
                                    Perubahan</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>