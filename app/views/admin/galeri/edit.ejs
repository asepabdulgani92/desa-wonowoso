<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Edit Info Foto</h3>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <% if (galeri.image) { %>
                        <img src="<%= galeri.image %>" class="img-fluid rounded shadow-sm" style="max-height: 200px;">
                        <% } else { %>
                            <div class="alert alert-secondary">Belum ada foto untuk galeri ini.</div>
                            <% } %>
                </div>
                <form action="/admin/galeri/<%= galeri._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Judul Foto</label>
                        <input type="text" name="title" class="form-control" value="<%= galeri.title %>" required>
                    </div>
                    <div class="form-group">
                        <label>Kategori</label>
                        <select name="category" class="form-control">
                            <option value="Kegiatan" <%=galeri.category==='Kegiatan' ? 'selected' : '' %>>Kegiatan</option>
                            <option value="Pembangunan" <%=galeri.category==='Pembangunan' ? 'selected' : '' %>>Pembangunan</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Ganti Foto (Opsional)</label>
                        <div class="custom-file">
                            <input type="file" name="image" class="custom-file-input" id="galeriEditFile" data-preview-target="galeriEditPreview">
                            <label class="custom-file-label" for="galeriEditFile">Pilih file baru...</label>
                        </div>
                        <img id="galeriEditPreview" src="" alt="Preview gambar galeri baru" style="display:none; max-width:100%; max-height:220px; margin-top:10px; border-radius:8px; border:1px solid #ddd;">
                    </div>

                    <% if (galeri.image) { %>
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="deleteGaleriImage" name="deleteImage" value="true">
                                <label class="custom-control-label" for="deleteGaleriImage">Hapus foto ini</label>
                            </div>
                        </div>
                        <% } %>

                    <div class="form-group">
                        <a href="/admin/galeri" class="btn btn-secondary">Batal</a>
                        <button type="submit" class="btn btn-primary float-right">Update Info</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>