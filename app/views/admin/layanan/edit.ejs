<div class="row">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Form Edit Layanan</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <form action="/admin/layanan/<%= layanan._id %>" method="POST">
                    <input type="hidden" name="_method" value="PUT">
                    <div class="form-group">
                        <label for="inputName">Nama Layanan</label>
                        <input type="text" id="inputName" name="title" class="form-control" value="<%= layanan.title %>"
                            required>
                    </div>
                    <div class="form-group">
                        <label for="inputDescription">Deskripsi Layanan</label>
                        <textarea id="inputDescription" name="description" class="form-control" rows="4"
                            required><%= layanan.description %></textarea>
                    </div>
                    <div class="form-group">
                        <label for="inputRequirements">Persyaratan</label>
                        <textarea id="inputRequirements" name="requirements" class="form-control" rows="4"
                            placeholder="Tulis satu persyaratan per baris"><%= layanan.requirements ? layanan.requirements.join('\n') : '' %></textarea>
                    </div>
                    <div class="form-group">
                        <label for="inputIcon">Icon</label>
                        <select id="inputIcon" name="icon" class="form-control" onchange="document.getElementById('iconPreview').className = this.value + ' mr-2';">
                            <option value="fas fa-file-alt" <%= layanan.icon === 'fas fa-file-alt' ? 'selected' : '' %>>Dokumen / Surat</option>
                            <option value="fas fa-file-signature" <%= layanan.icon === 'fas fa-file-signature' ? 'selected' : '' %>>Surat / Pengantar</option>
                            <option value="fas fa-id-card" <%= layanan.icon === 'fas fa-id-card' ? 'selected' : '' %>>KTP / Identitas</option>
                            <option value="fas fa-users" <%= layanan.icon === 'fas fa-users' ? 'selected' : '' %>>Kelompok / Warga</option>
                            <option value="fas fa-clipboard-list" <%= layanan.icon === 'fas fa-clipboard-list' ? 'selected' : '' %>>Daftar / Proses</option>
                            <option value="fas fa-landmark" <%= layanan.icon === 'fas fa-landmark' ? 'selected' : '' %>>Desa / Pemerintahan</option>
                            <option value="fas fa-home" <%= layanan.icon === 'fas fa-home' ? 'selected' : '' %>>Rumah / Warga</option>
                            <option value="fas fa-map-marker-alt" <%= layanan.icon === 'fas fa-map-marker-alt' ? 'selected' : '' %>>Lokasi</option>
                            <option value="fas fa-user-shield" <%= layanan.icon === 'fas fa-user-shield' ? 'selected' : '' %>>Keamanan / Legal</option>
                            <option value="fas fa-balance-scale" <%= layanan.icon === 'fas fa-balance-scale' ? 'selected' : '' %>>Hukum / Administrasi</option>
                            <option value="fas fa-bullhorn" <%= layanan.icon === 'fas fa-bullhorn' ? 'selected' : '' %>>Pengumuman</option>
                            <option value="fas fa-heart" <%= layanan.icon === 'fas fa-heart' ? 'selected' : '' %>>Layanan Sosial</option>
                        </select>
                        <div class="mt-2">
                            <small class="text-muted">Preview:</small>
                            <i id="iconPreview" class="<%= layanan.icon || 'fas fa-file-alt' %> ml-2" aria-hidden="true"></i>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <a href="/admin/layanan" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success float-right">Simpan Perubahan</button>
                        </div>
                    </div>
                </form>
            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->
    </div>
</div>