<div class="row">
    <div class="col-12">
        <div class="card card-primary card-outline card-tabs">
            <div class="card-header p-0 pt-1 border-bottom-0">
                <ul class="nav nav-tabs" id="custom-tabs-three-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link <%= currentStatus === 'Pending' ? 'active' : '' %>"
                            href="/admin/pengajuan?status=Pending">
                            Pending <span class="badge badge-warning right ml-2">
                                <%= counts.Pending %>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentStatus === 'Approved' ? 'active' : '' %>"
                            href="/admin/pengajuan?status=Approved">
                            Disetujui <span class="badge badge-success right ml-2">
                                <%= counts.Approved %>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentStatus === 'Rejected' ? 'active' : '' %>"
                            href="/admin/pengajuan?status=Rejected">
                            Ditolak <span class="badge badge-danger right ml-2">
                                <%= counts.Rejected %>
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap">
                        <thead>
                            <tr>
                                <th>Tanggal</th>
                                <th>Nama Pemohon</th>
                                <th>Layanan</th>
                                <th>Status</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (pengajuans.length> 0) { %>
                                <% pengajuans.forEach(item=> { %>
                                    <tr>
                                        <td>
                                            <%= new Date(item.createdAt).toLocaleDateString('id-ID', { day: 'numeric' ,
                                                month: 'long' , year: 'numeric' , hour: '2-digit' , minute: '2-digit' })
                                                %>
                                        </td>
                                        <td>
                                            <strong>
                                                <%= item.nama %>
                                            </strong><br>
                                            <span class="text-muted" style="font-size: 0.9em;">
                                                <%= item.email %>
                                            </span>
                                        </td>
                                        <td>
                                            <%= item.layananId ? item.layananId.title : 'Layanan Terhapus' %>
                                        </td>
                                        <td>
                                            <% if (item.status==='Pending' ) { %>
                                                <span class="badge badge-warning">Pending</span>
                                                <% } else if (item.status==='Approved' ) { %>
                                                    <span class="badge badge-success">Disetujui</span>
                                                    <% } else { %>
                                                        <span class="badge badge-danger">Ditolak</span>
                                                        <% } %>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-info" type="button"
                                                onclick="openDetail('<%= item._id %>')">
                                                <i class="fas fa-eye"></i> Detail
                                            </button>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="text-center py-4">
                                                    <div class="text-muted">
                                                        <i class="fas fa-inbox fa-3x mb-3" style="opacity: 0.3;"></i>
                                                        <p>Tidak ada data pengajuan <%= currentStatus %>
                                                        </p>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /.card -->
        </div>
    </div>
</div>

<!-- Modal Detail Pengajuan -->
<div class="modal fade" id="modalDetail" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detail Pengajuan</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Data Pemohon -->
                    <div class="col-md-6">
                        <h6>Data Pemohon</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td width="120">Nama</td>
                                <td id="dNama">: </td>
                            </tr>
                            <tr>
                                <td>Jenis Kelamin</td>
                                <td id="dJenisKelamin">: </td>
                            </tr>
                            <tr>
                                <td>Tempat Lahir</td>
                                <td id="dTempatLahir">: </td>
                            </tr>
                            <tr>
                                <td>Tanggal Lahir</td>
                                <td id="dTanggalLahir">: </td>
                            </tr>
                            <tr>
                                <td>Kewarganegaraan</td>
                                <td id="dKewarganegaraan">: </td>
                            </tr>
                            <tr>
                                <td>Agama</td>
                                <td id="dAgama">: </td>
                            </tr>
                            <tr>
                                <td>Pekerjaan</td>
                                <td id="dPekerjaan">: </td>
                            </tr>
                            <tr>
                                <td>RT/RW</td>
                                <td id="dRtRw">: </td>
                            </tr>
                            <tr>
                                <td>KTP</td>
                                <td id="dKtp">: </td>
                            </tr>
                            <tr>
                                <td>KK</td>
                                <td id="dKk">: </td>
                            </tr>
                            <tr>
                                <td>File KTP</td>
                                <td id="dKtpFile">: </td>
                            </tr>
                            <tr>
                                <td>File KK</td>
                                <td id="dKkFile">: </td>
                            </tr>
                            <tr>
                                <td>Tanggal Berlaku</td>
                                <td id="dTanggalBerlaku">: </td>
                            </tr>
                            <tr>
                                <td>No. HP</td>
                                <td id="dPhone">: </td>
                            </tr>
                            <tr>
                                <td>Email</td>
                                <td id="dEmail">: </td>
                            </tr>
                        </table>
                        <div class="mt-2">
                            <strong>Alamat:</strong>
                            <p id="dAddress" class="text-muted"></p>
                        </div>
                    </div>
                    <!-- Data Layanan -->
                    <div class="col-md-6 border-left">
                        <h6>Informasi Layanan</h6>
                        <p>
                            <strong>Jenis Layanan:</strong><br>
                            <span id="dLayanan" class="text-primary font-weight-bold"></span>
                        </p>
                        <div class="mt-2">
                            <strong>Keperluan / Keterangan:</strong>
                            <p id="dDescription" class="text-muted p-2 bg-light rounded"></p>
                        </div>
                    </div>
                </div>

                <!-- Admin Action Area -->
                <div id="actionArea" class="mt-4 pt-3 border-top">
                    <div id="pendingActions" style="display: none;">
                        <h6 class="mb-3">Tindak Lanjut</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card card-success card-outline">
                                    <div class="card-header border-0 pb-0">
                                        <h3 class="card-title text-success"><i class="fas fa-check-circle"></i> Setujui
                                            Pengajuan</h3>
                                    </div>
                                    <div class="card-body">
                                        <form id="formApprove" method="POST" action="/admin/pengajuan/preview">
                                            <input type="hidden" name="pengajuanId" id="pengajuanId" value="">
                                            <div class="form-group">
                                                <label class="small">Nomor Surat</label>
                                                <input type="text" name="nomorSurat" class="form-control form-control-sm" required placeholder="Masukkan nomor surat">
                                            </div>
                                            <button type="submit" name="submitPreview" class="btn btn-success btn-block btn-sm">
                                                <i class="fas fa-eye"></i> Preview & Approve
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card card-danger card-outline">
                                    <div class="card-header border-0 pb-0">
                                        <h3 class="card-title text-danger"><i class="fas fa-times-circle"></i> Tolak
                                            Pengajuan</h3>
                                    </div>
                                    <div class="card-body">
                                        <form id="formReject" method="POST">
                                            <div class="form-group">
                                                <label class="small">Alasan Penolakan</label>
                                                <textarea name="rejectionReason" class="form-control form-control-sm"
                                                    rows="2" required placeholder="Jelaskan alasan..."></textarea>
                                            </div>
                                            <button type="button" class="btn btn-danger btn-block btn-sm" onclick="tolakPengajuan()">
                                                <i class="fas fa-ban"></i> Kirim Penolakan
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="approvedInfo" style="display: none;">
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i> Pengajuan telah disetujui.
                            <br>Silakan lihat preview surat di halaman detail pengajuan.
                        </div>
                    </div>

                    <div id="rejectedInfo" style="display: none;">
                        <div class="alert alert-danger">
                            <i class="fas fa-times-circle"></i> Pengajuan ditolak.
                            <br>Alasan: <strong id="textRejectionReason"></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const pengajuanDataMap = {};
    let selectedPengajuanId = null;

    <% pengajuans.forEach(item => { %>
        pengajuanDataMap['<%= item._id %>'] = <%- JSON.stringify(item) %>;
    <% }) %>

    function openDetail(pengajuanId) {
        selectedPengajuanId = pengajuanId;
        const data = pengajuanDataMap[pengajuanId];
        if (!data) {
            console.error('Pengajuan data not found for ID', pengajuanId);
            return;
        }

        // Populate Data Pemohon
        $('#dNama').text(': ' + data.nama);
        $('#dJenisKelamin').text(': ' + (data.jenisKelamin || '-'));
        $('#dTempatLahir').text(': ' + (data.tempatLahir || '-'));
        $('#dTanggalLahir').text(': ' + (data.tanggalLahir ? new Date(data.tanggalLahir).toLocaleDateString('id-ID') : '-'));
        $('#dKewarganegaraan').text(': ' + (data.kewarganegaraan || '-'));
        $('#dAgama').text(': ' + (data.agama || '-'));
        $('#dPekerjaan').text(': ' + (data.pekerjaan || '-'));
        $('#dRtRw').text(': ' + ((data.rt || '-') + ' / ' + (data.rw || '-')));
        $('#dKtp').text(': ' + (data.ktp ? 'Ya' : 'Tidak'));
        $('#dKk').text(': ' + (data.kk ? 'Ya' : 'Tidak'));
        $('#dKtpFile').html(data.ktpFile ? `<a href="/uploads/user_docs/${data.ktpFile}" target="_blank" class="text-info"><i class="fas fa-paperclip"></i> Lihat File KTP</a>` : '-');
        $('#dKkFile').html(data.kkFile ? `<a href="/uploads/user_docs/${data.kkFile}" target="_blank" class="text-info"><i class="fas fa-paperclip"></i> Lihat File KK</a>` : '-');
        $('#dTanggalBerlaku').text(': ' + (data.tanggalBerlaku ? new Date(data.tanggalBerlaku).toLocaleDateString('id-ID') : '-'));
        $('#dPhone').text(': ' + data.phone);
        $('#dEmail').text(': ' + data.email);
        $('#dAddress').text(data.address || '-');

        $('#dLayanan').text(data.layananId ? data.layananId.title : 'Layanan tak ditemukan');
        $('#dDescription').text(data.keperluan || '-');

        // Action Area Logic
        $('#pendingActions').hide();
        $('#approvedInfo').hide();
        $('#rejectedInfo').hide();

        if (data.status === 'Pending') {
            $('#pendingActions').show();
            const rejectAction = `/admin/pengajuan/${encodeURIComponent(data._id)}/reject`;
            $('#pengajuanId').val(data._id);
            $('#formReject').attr('action', rejectAction);
            console.log('[DEBUG] formApprove action set to', $('#formApprove').attr('action'));
            console.log('[DEBUG] hidden pengajuanId set to', $('#pengajuanId').val());
        } else if (data.status === 'Approved') {
            $('#approvedInfo').show();
            $('#linkAdminFile').hide();
        } else if (data.status === 'Rejected') {
            $('#rejectedInfo').show();
            $('#textRejectionReason').text(data.rejectionReason || '-');
        }

        $('#modalDetail').modal('show');
    }

    function tolakPengajuan() {
        if (!selectedPengajuanId) {
            alert('Pilih pengajuan terlebih dahulu.');
            return;
        }

        const data = pengajuanDataMap[selectedPengajuanId];
        if (!data) {
            alert('Data pengajuan tidak ditemukan.');
            return;
        }

        const rejectionReason = $('#formReject textarea[name="rejectionReason"]').val().trim();
        if (!rejectionReason) {
            alert('Alasan penolakan harus diisi.');
            return;
        }

        fetch('/admin/pengajuan/' + selectedPengajuanId + '/reject', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                rejectionReason: rejectionReason
            })
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('Reject request failed');
            }
            return response.text();
        })
        .catch(function (err) {
            console.error('Gagal menolak pengajuan:', err);
        });

        var email = encodeURIComponent(data.email || '');
        var nama = encodeURIComponent(data.nama || '');

        var mailUrl = "https://mail.google.com/mail/?view=cm&fs=1" +
            "&to=" + email +
            "&su=" + encodeURIComponent("Pengajuan Surat - Desa Wonowoso") +
            "&body=" + encodeURIComponent("Yth. Bapak/Ibu " + decodeURIComponent(nama) + ",\n\nMohon maaf, pengajuan surat Anda tidak dapat kami setujui.\n\nAlasan: " + rejectionReason + "\n\nTerima kasih,\nDesa Wonowoso");

        window.open(mailUrl, '_blank');

        $('#rejectedInfo').show();
        $('#textRejectionReason').text(rejectionReason);
        $('#pendingActions').hide();
        $('#formReject').trigger('reset');
    }

    // Custom File Input Label
    $(document).ready(function () {
        $('.custom-file-input').on('change', function () {
            let fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').addClass("selected").html(fileName);
        });

        $('#formApprove').on('submit', function (event) {
            const currentId = $('#pengajuanId').val();
            const currentAction = $(this).attr('action');
            console.log('[DEBUG] formApprove submit action=', currentAction, 'pengajuanId=', currentId, 'method=', this.method);
            if (!currentId) {
                event.preventDefault();
                alert('ID pengajuan tidak tersedia. Silakan buka kembali detail pengajuan.');
            }
        });
    });
</script>