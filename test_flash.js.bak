const http = require('http');

const options = {
  hostname: 'localhost',
  port: 3000,
  path: '/admin/login',
  method: 'POST',
  headers: {
    'Content-Type': 'application/x-www-form-urlencoded',
    'Content-Length': Buffer.byteLength('username=baddd&password=bad')
  }
};

const req = http.request(options, (res) => {
  console.log('STATUS:', res.statusCode);
  console.log('HEADERS:', res.headers);
  const cookies = res.headers['set-cookie'];

  if (cookies) {
    const getOptions = {
      hostname: 'localhost',
      port: 3000,
      path: '/admin/login',
      method: 'GET',
      headers: {
        'Cookie': cookies[0].split(';')[0]
      }
    };
    http.get(getOptions, (res2) => {
      let body = '';
      res2.on('data', chunk => body += chunk);
      res2.on('end', () => {
        console.log('Contains User tidak tersedia:', body.includes('User tidak tersedia'));
      });
    });
  }
});

req.write('username=baddd&password=bad');
req.end();
